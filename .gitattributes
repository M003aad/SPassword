# Normalize text files to LF line endings in the repository.
* text=auto

# Browser extension source and documentation.
*.cff text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
LICENSE text eol=lf

# Exclude repository documentation and screenshots from Git-generated archives.
README.md export-ignore
SUPPORT.md export-ignore
CODE_OF_CONDUCT.md export-ignore
CONTRIBUTING.md export-ignore
SECURITY.md export-ignore
CITATION.cff export-ignore
docs/** export-ignore
.github/** export-ignore
.gitattributes export-ignore

# Preserve WebP images as binary.
*.webp binary
